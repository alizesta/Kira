{
  "schema_version": 1,
  "kind": "events",
  "events": {
    "app_startup": {
      "emotion": "happy",
      "intensity": 40,
      "duration": 3,
      "pulse": "perk",
      "runtime_emotions": {
        "happy": 10,
        "curious": 5
      },
      "runtime_behaviors": {
        "cheerful": 5
      }
    },
    "user_message": {
      "emotion": "curious",
      "intensity": 28,
      "duration": 1.8,
      "pulse": "listen",
      "runtime_emotions": {
        "curious": 5
      },
      "runtime_behaviors": {
        "focused": 3
      }
    },
    "response_started": {
      "emotion": "thinking",
      "intensity": 45,
      "duration": 25,
      "runtime_emotions": {
        "thinking": 7
      },
      "runtime_behaviors": {
        "focused": 5
      }
    },
    "response_finished": {
      "pulse": "nod",
      "release_events": [
        "response_started"
      ]
    },
    "response_failed": {
      "emotion": "sad",
      "intensity": 40,
      "duration": 4,
      "release_events": [
        "response_started"
      ],
      "release_responses": true,
      "runtime_emotions": {
        "frustrated": 10
      },
      "runtime_behaviors": {
        "focused": 5
      }
    },
    "response_cancelled": {
      "release_events": [
        "response_started"
      ],
      "release_responses": true
    },
    "tts_started": {
      "speaking": true,
      "runtime_emotions": {
        "confident": 3
      }
    },
    "tts_stopped": {
      "speaking": false,
      "runtime_emotions": {
        "calm": 2
      }
    },
    "user_interrupt": {
      "emotion": "annoyed",
      "intensity": 35,
      "duration": 2.5,
      "pulse": "flinch",
      "speaking": false,
      "release_events": [
        "response_started"
      ],
      "runtime_emotions": {
        "surprised": 8
      },
      "runtime_behaviors": {
        "reserved": 4
      }
    }
  }
}
