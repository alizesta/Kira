# Copy this file to .env and replace every CHANGE_ME value.
# Never commit .env or send these secrets to clients.

POSTGRES_DB=kira_core
POSTGRES_USER=kira
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KIRA_TOKEN_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key backed up. Losing it makes stored Provider API keys unrecoverable.
KIRA_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# Native Windows/Android clients do not require browser CORS.
# Add exact trusted web origins only if a web client is introduced.
KIRA_CORS_ORIGINS=
KIRA_ACCESS_TOKEN_TTL=900
KIRA_REFRESH_TOKEN_TTL=2592000
